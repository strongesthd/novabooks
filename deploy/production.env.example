# Copy to /home/app/novabooks/.env on the VPS; chmod 600.
# Use base64url/hex secrets so the generated PostgreSQL URLs remain valid.
DB_DATABASE=novabooks
DB_ADMIN_USER=novabooks_admin
DB_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_URL_SAFE_SECRET
DB_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_URL_SAFE_SECRET
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
API_PORT=3015
MAX_UPLOAD_MB=12
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
TTS_API_KEY=
TTS_VOICE_ID=
DAILY_REPORT_CRON=0 18 * * *
