NODE_ENV=development
PORT=3000
HOST=127.0.0.1
DATABASE_URL=postgres://novabooks:novabooks-app-local-only@localhost:5432/novabooks
POSTGRES_ADMIN_PASSWORD=replace-with-url-safe-random-secret
POSTGRES_APP_PASSWORD=novabooks-app-local-only
DB_SSL=false
JWT_SECRET=replace-with-at-least-32-random-bytes
ENCRYPTION_KEY=replace-with-64-hexadecimal-characters
APP_BASE_URL=http://localhost:3000
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=12
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
TELEGRAM_WEBHOOK_BASE_PATH=/webhooks/telegram
TELEGRAM_BOT_API_BASE_URL=https://api.telegram.org
ZALO_API_BASE_URL=https://openapi.zalo.me
TTS_API_KEY=
TTS_VOICE_ID=
DAILY_REPORT_CRON=0 18 * * *
DB_DATABASE=novabooks
API_PORT=3015
